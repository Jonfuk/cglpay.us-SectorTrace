# Secrets
.env
secrets/
*.pem
*-service-account.json

# The Ansible self-host build's secrets file. ansible-vault encrypts it in
# place, at which point it's safe to track deliberately with `git add -f` —
# this is a safety net against committing it unencrypted by mistake, not a
# statement that an encrypted vault.yml can't be checked in.
deploy/ansible/group_vars/all/vault.yml
# Superseded vaults kept by `ansible-install.sh --reconfigure`. Encrypted,
# but still secrets, and each one is named for when it was replaced.
deploy/ansible/.vault-backups/
# Written by the setup wizard: this box's domain and any other local
# override. Loads after vars.yml and wins, so the tracked defaults stay
# clean and `git pull` never conflicts with a local answer.
deploy/ansible/group_vars/all/zz-local.yml
deploy/ansible/*.retry

# The mirror build's equivalents. Same rules, same reasons — and one more
# that is specific to it: this vault holds copies of the SOURCE
# deployment's credentials, so an unencrypted one committed here would leak
# the authoritative deployment's keys, not only this box's.
deploy/ansible-mirror/group_vars/all/vault.yml
deploy/ansible-mirror/.vault-backups/
deploy/ansible-mirror/group_vars/all/zz-local.yml
deploy/ansible-mirror/*.retry

# Operator-managed extra env for a `beta` box: module API keys for modules
# run on it by hand. It lives at <state_dir>/.env.merge on the box and is
# merged into the rendered .env on every playbook run; this entry is a
# backstop against a copy left in the checkout. The tracked
# deploy/ansible-mirror/.env.merge.example is the template.
.env.merge

# Data — raw archives and the canonical warehouse are local state, not source
data/raw/
data/warehouse.db
data/warehouse.db-*
# Verified snapshots of the warehouse, plus their manifests and archive
# listings. Regenerable by `pipeline backup`, and the same size as the thing
# they copy.
data/backups/
# Where an interrupted PostgreSQL migration keeps its place. Local state about
# one machine's load of one warehouse into one server, and it names the target
# — redacted, but still a hostname nobody has agreed to publish.
data/pg-migration-state.json

# Generated export payloads — reproducible from the warehouse with
# `./start.sh export all`, and large. The schema that produces them IS
# tracked (pipeline/exports/), so the shape is reviewable in code.
exports/output/

# Anything that could carry restricted_ (personal-data) columns out of the DB
exports/output/restricted_*
**/restricted_*.csv
**/restricted_*.json

# Logs
logs/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# uv
.uv/

# Local Claude Code state (machine-specific permission rules and paths)
.claude/

# graphify skill state and its persistent knowledge-graph output
.graphifyignore
graphify-out/

# mkdocs-material privacy plugin cache of vendored external assets
.cache/

# Extracted PDF page text — derived from data/raw/, regenerable, and large
data/text/

# Trained 034G claim-prediction head artifacts (logreg blobs, SetFit model
# dirs). Bind-mounted on the VPS, rebuilt by `nlp claims-train`, and their
# SHA-256 is on the claim_head_versions row — never committed.
nlp-cache/

# The documentation site is built, never committed. `uv run mkdocs build`
# writes it; CI builds it with --strict and keeps nothing.
/site/
