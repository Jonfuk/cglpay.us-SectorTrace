# Copy to .env and fill in. Never commit .env.

# --- Identity / politeness -------------------------------------------------
# Used to build the User-Agent header sent to every source and as the
# contact point a site operator can use to reach us about our scraping.
CONTACT_EMAIL=

# --- m15 WhatDoTheyKnow detail retrieval (disabled by default) -------------
# Requires explicit permission from mySociety/WhatDoTheyKnow before use.
WDTK_WEB_UNLOCKER_ENABLED=false
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# Alternative m15-only provider. Enable exactly one WDTK transport.
WDTK_ZENROWS_ENABLED=false
ZENROWS_API_KEY=
ZENROWS_JS_RENDER=true
ZENROWS_PREMIUM_PROXY=false
ZENROWS_PROXY_COUNTRY=gb

# The operator UI is enabled locally by default. Set this to false on hosted
# deployments where /admin and /api/admin should not be exposed.
ADMIN_UI_ENABLED=true

# --- Release identity (GET /api/v1/meta, portal footer) --------------------
# Injected by the deployment so reviewers can tell which build they are on.
# deploy/railway-start.sh sets these automatically on Railway; only set them
# by hand for a non-Railway hosted deployment. Left unset, `meta` reads
# .git/HEAD and reports the environment as "development".
# ENVIRONMENT=production
# GIT_REVISION=
# BUILD_TIME=

# --- Rate limiting ----------------------------------------------------------
# Default seconds between requests to any single host. Per-source overrides
# can be added to pipeline/config.py's RATE_LIMIT_OVERRIDES as needed.
DEFAULT_RATE_LIMIT_SECONDS=2.0

# --- Performance budgets ----------------------------------------------------
WEB_WORKERS=8
WEB_QUEUE_SIZE=32
BATCH_WRITE_ROWS=1000
BATCH_WRITE_SECONDS=5.0
HTTP_CACHE_WRITE_BATCH_SIZE=500
CSV_PARSE_WORKERS=1
PREDICTION_WRITE_BATCH_SIZE=2000
NLP_ACCELERATOR=auto
FAILED_ANALYSIS_DETAIL_RETENTION_DAYS=7
ANALYSIS_PREFILTER_SUPPRESSION_ENABLED=false
OPERATIONAL_SNAPSHOT_MAX_AGE_SECONDS=900
JOB_WORKERS=1
JOB_EVENT_RETENTION_LINES=4000

# --- Database / storage ------------------------------------------------------
# PostgreSQL 18 is the only application warehouse. There is no SQLite fallback
# or DATABASE_BACKEND selector.
#
#   DATABASE_URL=postgresql://sectortrace_app:PASSWORD@host:5432/sectortrace
#
# The password belongs here and nowhere else — never in a command line (it
# reaches the shell history and the process table) and never in the
# repository. Logs and the health tab show it redacted.
#
DATABASE_URL=

# The same warehouse as a role that can only SELECT. The portal and the
# operator UI read through this; nothing writes through it.
#
# This is the PostgreSQL replacement for SQLite's read-only file handle, and
# the difference between setting it and not is worth understanding rather than
# copying. Without it, reads fall back to DATABASE_URL — the role that owns
# the schema — and the only thing stopping the SQL box writing is a session
# setting the application asks for. A role without INSERT refuses at the
# server, whatever a bug in the code does.
#
# Meaningful only alongside DATABASE_URL: it names a second role on the same
# database, it does not select the backend. Setting this one alone is refused
# rather than ignored, so nobody ends up believing in a guarantee they do not
# have.
#
#   DATABASE_RO_URL=postgresql://sectortrace_reader:PASSWORD@host:5432/sectortrace
#
# See pipeline/migrations/postgres/README.md for creating the two roles.
DATABASE_RO_URL=

# The PostgreSQL test suites' database, and deliberately not either of the two
# above. Everything in tests/test_postgres_live.py and
# tests/test_pg_migration_live.py writes, and the migration suite truncates
# every table it loads — so pointing the tests at a database has to be a
# separate act, and can never happen by inheriting a working configuration.
# Unset, those suites skip and the offline suite needs no server at all.
#
#   POSTGRES_TEST_URL=postgresql://sectortrace_app:PASSWORD@host:5432/sectortrace_test
#   POSTGRES_TEST_RO_URL=postgresql://sectortrace_reader:PASSWORD@host:5432/sectortrace_test
POSTGRES_TEST_URL=
POSTGRES_TEST_RO_URL=

# --- Derived Evidence Graph -------------------------------------------------
# Neo4j is optional and never authoritative.  It is rebuilt from the warehouse
# by `pipeline graph rebuild`; leave this disabled for ordinary collection.
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_VERIFY_CONNECTIVITY=true
# Keep a projection transaction small enough for a hosted graph service, and
# prevent an accidental full warehouse load into NetworkX.
GRAPH_BATCH_SIZE=500
GRAPH_MAX_NODES=10000
GRAPH_MAX_EDGES=50000
RAW_ARCHIVE_DIR=data/raw
# Leave all ARCHIVE_S3_* unset for the filesystem backend. Set the complete
# group together to make a private S3-compatible bucket the primary archive.
# ARCHIVE_S3_BUCKET=
# ARCHIVE_S3_ENDPOINT=
# ARCHIVE_S3_REGION=ams
# ARCHIVE_S3_URL_STYLE=virtual
# ARCHIVE_S3_ACCESS_KEY=
# ARCHIVE_S3_SECRET=

# --- Structured document analysis (local-heavy, never required by Railway) --
# Install with `uv sync --extra documents`; OCRmyPDF additionally needs its
# operating-system dependencies (Tesseract and Ghostscript).  Raw bytes stay
# below RAW_ARCHIVE_DIR; OCR PDFs and other mutable parser outputs go here.
DOCUMENT_ANALYSIS_ENABLED=true
DOCUMENT_PARSER=docling
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_MAX_FILE_SIZE_MB=100
DOCUMENT_MAX_PAGES=500
DOCUMENT_MIN_TEXT_CHARS_PER_PAGE=40
DOCUMENT_MAX_ZERO_TEXT_PAGE_RATIO=0.60
DOCUMENT_PARSE_TIMEOUT_SECONDS=900
DERIVED_ARCHIVE_DIR=data/derived
# Optional separate S3-compatible store for derived artifacts only.  Set all
# six values together; do not point this at raw archive keys.
# DERIVED_ARCHIVE_S3_BUCKET=
# DERIVED_ARCHIVE_S3_ENDPOINT=
# DERIVED_ARCHIVE_S3_REGION=
# DERIVED_ARCHIVE_S3_URL_STYLE=virtual
# DERIVED_ARCHIVE_S3_ACCESS_KEY=
# DERIVED_ARCHIVE_S3_SECRET=
# Leave all ARCHIVE_S3_* unset for the filesystem backend. Set the complete
# group together to make a private S3-compatible bucket the primary archive.
# ARCHIVE_S3_BUCKET=
# ARCHIVE_S3_ENDPOINT=
# ARCHIVE_S3_REGION=ams
# ARCHIVE_S3_URL_STYLE=virtual
# ARCHIVE_S3_ACCESS_KEY=
# ARCHIVE_S3_SECRET=

# --- Logs ----------------------------------------------------------------------
# One file per module, rotated by size: LOG_BACKUP_COUNT generations of
# LOG_MAX_BYTES each, so a module is bounded at the product of the two.
# Discarding the oldest generation costs the ability to reconstruct a
# months-old run and nothing a published figure rests on -- the provenance
# that matters is in the warehouse and in data/raw/. Raise these if you want a
# longer operational record.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Module 3: Charity Commission register API -------------------------------
CHARITY_COMMISSION_API_KEY=

# --- Module 4: Companies House public API -------------------------------------
COMPANIES_HOUSE_API_KEY=

# --- Module 5: CQC public API --------------------------------------------------
CQC_SUBSCRIPTION_KEY=

# --- Module 1's --kag channel: Kaggle-hosted Contracts Finder re-host --------
# A free account's API token (Account settings -> Create New Token, downloads
# kaggle.json with these two values). Only needed for `pipeline run
# m01_procurement --kag`; --csv (the default) and --api need neither.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Module 8: reading scanned reports -----------------------------------------
# Roughly two thirds of Prevention of Future Deaths reports are published as a
# scan rather than as text. Without OCR those are recorded as unreadable, and
# their matters of concern never enter the evidence base.
#
# Setting this true also makes start.sh / start.cmd install the `ocr` extra,
# so one switch is enough. It is off by default because it is expensive: about
# nine seconds a page, which puts the current backlog at several hours, and
# the first run downloads ~105 MB of models to ~/.cache/onnxtr.
#
# Text read this way is recorded with concerns_source='ocr', because it is
# legible and not a faithful transcript.
OCR_ENABLED=false

# --- Exports: Google Sheets ----------------------------------------------------
# PATH to a service-account JSON credential file — not the JSON itself.
# Put the file in secrets/ (gitignored), e.g.
#   GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-service-account.json
# Pasting the raw JSON blob here will not work: dotenv cannot parse an
# unquoted multi-line value, and config.py expects a path.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Railway alternative: base64-encoded contents of the JSON file. Leave this
# unset locally when GOOGLE_SERVICE_ACCOUNT_JSON points to a local file.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEETS_SPREADSHEET_ID=
