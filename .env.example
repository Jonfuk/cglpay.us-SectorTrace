# Copy to .env and fill in. Never commit .env.

# --- Identity / politeness -------------------------------------------------
# Used to build the User-Agent header sent to every source and as the
# contact point a site operator can use to reach us about our scraping.
CONTACT_EMAIL=

# --- Rate limiting ----------------------------------------------------------
# Default seconds between requests to any single host. Per-source overrides
# can be added to pipeline/config.py's RATE_LIMIT_OVERRIDES as needed.
DEFAULT_RATE_LIMIT_SECONDS=2.0

# --- Database / storage ------------------------------------------------------
DATABASE_PATH=data/warehouse.db
RAW_ARCHIVE_DIR=data/raw

# --- Module 3: Charity Commission register API -------------------------------
CHARITY_COMMISSION_API_KEY=

# --- Module 4: Companies House public API -------------------------------------
COMPANIES_HOUSE_API_KEY=

# --- Module 5: CQC public API --------------------------------------------------
CQC_SUBSCRIPTION_KEY=

# --- Exports: Google Sheets ----------------------------------------------------
# Path to a service-account JSON credential file (not committed).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
