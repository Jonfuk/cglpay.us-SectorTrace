{# Docker's daemon.json accepts configuration keys only; JSON has no comments. #}
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "50m",
    "max-file": "3"
  },

  "live-restore": true,

  "no-new-privileges": true,

  "default-ulimits": {
    "nofile": {
      "Name": "nofile",
      "Soft": 65535,
      "Hard": 65535
    }
  }
}
