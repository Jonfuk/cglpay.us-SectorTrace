# Generated by Ansible from group_vars/all/{vars,vault}.yml — do not edit by
# hand, it will be overwritten on the next playbook run. Edit vault.yml (or
# vars.yml for non-secret values) and re-run ansible-install.sh instead.

CONTACT_EMAIL={{ contact_email }}
ADMIN_UI_ENABLED={{ admin_ui_enabled | lower }}

# --- Database: PostgreSQL, the two roles created in postgres-init/01-roles.sql
DATABASE_URL=postgresql://sectortrace_app:{{ vault_postgres_app_password }}@postgres:5432/sectortrace
DATABASE_RO_URL=postgresql://sectortrace_reader:{{ vault_postgres_reader_password }}@postgres:5432/sectortrace

# --- Derived Evidence Graph: Neo4j -------------------------------------------
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD={{ vault_neo4j_password }}
NEO4J_DATABASE=neo4j

# --- Raw archive --------------------------------------------------------------
{% if vault_archive_s3_bucket %}
ARCHIVE_S3_BUCKET={{ vault_archive_s3_bucket }}
ARCHIVE_S3_ENDPOINT={{ vault_archive_s3_endpoint }}
ARCHIVE_S3_REGION={{ vault_archive_s3_region }}
ARCHIVE_S3_URL_STYLE={{ vault_archive_s3_url_style }}
ARCHIVE_S3_ACCESS_KEY={{ vault_archive_s3_access_key }}
ARCHIVE_S3_SECRET={{ vault_archive_s3_secret }}
{% else %}
# vault_archive_s3_bucket is unset — falling back to the filesystem archive
# under RAW_ARCHIVE_DIR inside the app container. Fill in the ARCHIVE_S3_*
# group in vault.yml to point this at your existing bucket instead.
RAW_ARCHIVE_DIR=data/raw
{% endif %}

# --- Structured document analysis --------------------------------------------
# The always-on app container never installs the `documents` extra (see
# Dockerfile) and never processes documents — that happens in the separate
# documents-worker image, run on demand via docker-compose.documents.yml.
# These settings only take effect there.
DOCUMENT_ANALYSIS_ENABLED=true
DOCUMENT_PARSER=pymupdf
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGE=eng
DERIVED_ARCHIVE_DIR=data/derived

# --- Module API keys (blank is fine; only that module refuses at runtime) ---
CHARITY_COMMISSION_API_KEY={{ vault_charity_commission_api_key }}
COMPANIES_HOUSE_API_KEY={{ vault_companies_house_api_key }}
CQC_SUBSCRIPTION_KEY={{ vault_cqc_subscription_key }}
KAGGLE_USERNAME={{ vault_kaggle_username }}
KAGGLE_KEY={{ vault_kaggle_key }}
