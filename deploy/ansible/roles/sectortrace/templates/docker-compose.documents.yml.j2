# Generated by Ansible. Deliberately separate from docker-compose.yml: this
# image is built here; document parsing remains on-demand while the analysis
# worker is a long-lived queue consumer. Both attach to the same Docker
# network as the always-on stack so `postgres` and `neo4j` resolve by service
# name.
name: sectortrace-documents

networks:
  default:
    name: sectortrace_net
    external: true

services:
  documents:
    build:
      context: "{{ repo_root }}"
      dockerfile: deploy/Dockerfile.documents
      args:
        # The [assistant] extra (`openai`) when this box runs the assistant —
        # either against OpenRouter (assistant_app_enabled) or a self-hosted
        # Ollama (assistant_runtime_enabled). `nlp assistant` and `nlp
        # assistant-eval` run in this worker. Railway builds neither this
        # file nor this arg.
        INSTALL_ASSISTANT: "{{ (assistant_runtime_enabled or assistant_app_enabled) | lower }}"
    env_file:
      - "{{ state_dir }}/.env"
    # The blast-radius limit. Parsing and OCR are the spiky part of this
    # deployment — a large scanned PDF, or Docling's torch-based layout
    # models if you switch DOCUMENT_PARSER, can allocate hard. Hitting a
    # cgroup limit kills this container alone and records a retryable
    # failure; without it the kernel's OOM killer chooses host-wide and may
    # well pick PostgreSQL.
    mem_limit: {{ documents_mem_limit_mb }}m
    # Leave the database and the portal responsive while a batch runs.
    cpus: {{ [(ansible_processor_vcpus | int * 0.75) | round(1), 1.0] | max }}
    volumes:
      # Same whole-of-/app/data mount as the app: this worker READS raw
      # objects from the archive and writes derived artifacts beside them,
      # so it needs the identical view. Its own logs go to /tmp by design
      # (LOGS_DIR in deploy/Dockerfile.documents).
      - "{{ state_dir }}/data:/app/data"
    # No `restart:` and no default command — always invoked explicitly, e.g.:
    #   docker compose -f docker-compose.documents.yml run --rm documents documents status
    #   docker compose -f docker-compose.documents.yml run --rm documents documents process --source-system committee_papers --limit 25

  analysis-worker:
    build:
      context: "{{ repo_root }}"
      dockerfile: deploy/Dockerfile.documents
      args:
        INSTALL_ASSISTANT: "{{ (assistant_runtime_enabled or assistant_app_enabled) | lower }}"
    env_file:
      - "{{ state_dir }}/.env"
    mem_limit: {{ documents_mem_limit_mb }}m
    cpus: {{ [(ansible_processor_vcpus | int * 0.75) | round(1), 1.0] | max }}
    volumes:
      - "{{ state_dir }}/data:/app/data"
    restart: unless-stopped
    command: ["analysis", "worker", "--poll-seconds", "5"]
