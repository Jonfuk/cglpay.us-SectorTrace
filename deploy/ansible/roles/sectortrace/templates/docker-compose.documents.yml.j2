# Generated by Ansible. Deliberately separate from docker-compose.yml: this
# image is built here but never brought up with `docker compose up` — it's
# on-demand batch work, run explicitly, per docs/document-analysis.md and
# docs/unraid-document-worker.md. It attaches to the same Docker network as
# the always-on stack so `postgres` and `neo4j` resolve by service name.
name: sectortrace-documents

networks:
  default:
    name: sectortrace_net
    external: true

services:
  documents:
    build:
      context: "{{ repo_root }}"
      dockerfile: deploy/Dockerfile.documents
    env_file:
      - "{{ state_dir }}/.env"
    volumes:
      - "{{ state_dir }}/data/derived:/app/data/derived"
    # No `restart:` and no default command — always invoked explicitly, e.g.:
    #   docker compose -f docker-compose.documents.yml run --rm documents documents status
    #   docker compose -f docker-compose.documents.yml run --rm documents documents process --source-system committee_papers --limit 25
