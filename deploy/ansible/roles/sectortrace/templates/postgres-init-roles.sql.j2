-- Generated by Ansible. Runs once, automatically, only when the Postgres
-- container initialises an *empty* /var/lib/postgresql/data — see
-- docker-compose.yml's postgres-init bind mount. sectortrace_app itself is
-- created by the official image from POSTGRES_USER/POSTGRES_PASSWORD before
-- this runs; this file adds the read-only role DATABASE_RO_URL points at.
--
-- See pipeline/migrations/postgres/README.md for why the split exists: a
-- role without INSERT refuses at the server, whatever a bug in the
-- application code does.
CREATE ROLE sectortrace_reader LOGIN PASSWORD '{{ vault_postgres_reader_password }}';
GRANT CONNECT ON DATABASE sectortrace TO sectortrace_reader;
GRANT USAGE ON SCHEMA public TO sectortrace_reader;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO sectortrace_reader;

-- No tables exist yet at first init — `pipeline migrate` creates them after
-- this script runs, as sectortrace_app. This is what makes sectortrace_reader
-- keep up with every migration from here on without a manual GRANT.
ALTER DEFAULT PRIVILEGES FOR ROLE sectortrace_app IN SCHEMA public
    GRANT SELECT ON TABLES TO sectortrace_reader;
