# Generated by Ansible — see roles/sectortrace/templates/docker-compose.assistant.yml.j2.
#
# The local analyst assistant's model runtime (BETA-107). One Ollama
# serving both roles the assistant calls — synthesis and the router. The
# playbook `ollama pull`s assistant_lfm_ollama_ref, and env.j2 sets
# ASSISTANT_LFM_MODEL / ASSISTANT_NEEDLE_MODEL to that same string, so the
# name the app sends is the name Ollama has. ASSISTANT_OLLAMA_URL and
# ASSISTANT_NEEDLE_URL in .env both point here.
#
# Unlike docker-compose.documents.yml this file IS brought up with the
# stack — but only when assistant_runtime_enabled is true. Rendered either
# way so `docker compose -f docker-compose.assistant.yml config` works and
# the file is present the day someone flips the switch.
name: sectortrace-assistant

networks:
  default:
    # The always-on stack's network, joined by name — same pattern as the
    # documents worker. `postgres`/`app` never talk to Ollama, but the app
    # reaches it here as http://ollama:11434.
    name: sectortrace_net
    external: true

volumes:
  # Model weights (the 1.2B default is ~730 MB; 350M ~220 MB, 2.6B ~1.6 GB)
  # plus Ollama's manifests. A named volume, not state_dir/data: it is not
  # warehouse content, must outlive a `pipeline restore`, and is safe to
  # delete — the playbook re-pulls. `docker volume inspect
  # sectortrace-assistant_ollama-models` says where it lives.
  ollama-models:

services:
  ollama:
    image: {{ assistant_ollama_image }}
    restart: unless-stopped
    environment:
      # Listen on the compose network. No `ports:` block, so nothing off-box
      # can reach it; the app container resolves `ollama` by service name.
      OLLAMA_HOST: "0.0.0.0:11434"
      # Ollama's default is 2048, which truncates the grounding step's
      # retrieved passages. assistant_ollama_context_length sizes it — the
      # design wants 32K, but the KV cache for that on a multi-B model can
      # push a small box into swap, so the deploy default is smaller.
      OLLAMA_CONTEXT_LENGTH: "{{ assistant_ollama_context_length }}"
      # Keep the model resident an hour after the last call. The assistant is
      # interactive and bursty, `nlp assistant-eval` fires ~160 calls in
      # sequence, and on a CPU box the cold reload is the slow part — this
      # container exists only to serve this model, so hold it.
      OLLAMA_KEEP_ALIVE: "60m"
    # A ceiling, not a reservation — a runaway hits this and is killed
    # alone rather than the kernel's OOM killer choosing PostgreSQL. See
    # assistant_ollama_mem_limit_mb in vars.yml for why it is not in the
    # preflight budget.
    mem_limit: {{ assistant_ollama_mem_limit_mb }}m
    volumes:
      - ollama-models:/root/.ollama
    healthcheck:
      # `ollama list` talks to the local daemon and fails until it is
      # serving — a readiness signal, not just "process alive".
      test: ["CMD-SHELL", "ollama list >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
