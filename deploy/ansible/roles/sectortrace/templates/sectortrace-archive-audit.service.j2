# Generated by Ansible. The daily raw-archive audit sample (performance.md's
# Phase 5 archive-audit gap): a deterministic 1% sample, at least 100
# objects, re-hashed against the archive itself — not only a report of what
# the database believes is there. Any mismatch is quarantined
# (quarantine_items), never deleted. See pipeline/archive_audit.py.
[Unit]
Description=SectorTrace daily raw-archive audit sample
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory={{ state_dir }}
ExecStart=/usr/bin/docker compose -f docker-compose.yml exec -T app python -m pipeline archive-audit
