# Generated by Ansible. Caddy handles TLS (automatic Let's Encrypt) and
# fronts only the public portal — /admin and /api/admin/* are refused here
# rather than proxied, since the app has no authentication of its own
# (settled decision 8). Reach the operator UI over an SSH tunnel instead:
#   ssh -L 1801:127.0.0.1:1801 <user>@{{ domain }} -N
#   open http://127.0.0.1:1801/admin

{{ domain }} {
{% if expose_admin_publicly %}
    reverse_proxy app:1801
{% else %}
    @admin path /admin* /api/admin*
    respond @admin 403

    reverse_proxy app:1801
{% endif %}
}
