# Generated by Ansible. Captures one PostgreSQL maintenance-telemetry
# snapshot (pipeline pg-telemetry-snapshot — see pipeline/pg_telemetry.py and
# migration 0107) into pg_telemetry_*, so performance.md's "PostgreSQL
# maintenance" observation period has accumulated evidence rather than only a
# live point-in-time answer. Capture only: never changes autovacuum, index,
# or planner/memory configuration.
[Unit]
Description=SectorTrace PostgreSQL maintenance-telemetry snapshot
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory={{ state_dir }}
ExecStart=/usr/bin/docker compose -f docker-compose.yml exec -T app python -m pipeline pg-telemetry-snapshot
