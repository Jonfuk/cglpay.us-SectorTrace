# Generated by Ansible — see roles/sectortrace/templates/docker-compose.selfhost.yml.j2.
# The always-on trio (postgres, neo4j, app) plus Caddy in front of it.
# Document processing is deliberately not here — see docker-compose.documents.yml,
# built by the same playbook run but only ever `run`, never `up`, matching the
# documented architecture: the always-on service does small incremental
# graph syncs, never full archive reprocessing or OCR batches.
name: sectortrace

networks:
  default:
    name: sectortrace_net

# Named volumes for the two databases rather than bind mounts into
# state_dir, which is what the earlier revisions did. Two reasons, both
# learned the hard way on a real box:
#
#  * PostgreSQL 18+ images store data in a major-version subdirectory and
#    declare the volume at /var/lib/postgresql, not .../data. A bind mount
#    one level too deep is reported as an "unused mount/volume" and the
#    container refuses to start if anything is in it.
#  * Both entrypoints drop from root to their own service user, and neither
#    chowns the *parent* of its data directory. A root-owned bind mount is
#    then untraversable by the very user that needs it. Docker seeds a fresh
#    named volume from the image, ownership included, so the question never
#    arises.
#
# The warehouse is still backed up by `pipeline backup` (verified, plus the
# offsite copy), which is the supported path — not by copying a data
# directory out from under a running server. `docker volume inspect
# sectortrace_postgres-data` says where it physically lives.
volumes:
  postgres-data:
  neo4j-data:
  neo4j-logs:
  caddy-data:
  caddy-config:

services:
  postgres:
    image: postgres:18
    restart: unless-stopped
    environment:
      POSTGRES_USER: sectortrace_app
      POSTGRES_PASSWORD: "{{ vault_postgres_app_password }}"
      # Deliberately the maintenance database, NOT sectortrace. The warehouse
      # needs the builtin C.UTF-8 collation so ORDER BY matches SQLite's
      # BINARY ordering (pipeline/migrations/postgres/README.md), and letting
      # the image create it here would create it with the cluster default
      # instead. postgres-init/01-roles.sql creates it properly, with the
      # CREATE DATABASE ... TEMPLATE = template0 form that README documents.
      #
      # Doing it at CREATE DATABASE rather than initdb also avoids a conflict
      # that is easy to miss: this image sets LANG=en_US.utf8, and initdb
      # refuses --locale-provider=builtin when LC_CTYPE disagrees with it, so
      # a POSTGRES_INITDB_ARGS approach fails before the server ever starts.
      POSTGRES_DB: postgres
    command: >
      postgres
      -c shared_buffers={{ postgres_shared_buffers }}
      -c effective_cache_size={{ postgres_effective_cache_size }}
      -c max_connections={{ postgres_max_connections }}
      -c work_mem={{ postgres_work_mem }}
      -c maintenance_work_mem={{ postgres_maintenance_work_mem }}
      -c max_worker_processes={{ postgres_max_worker_processes }}
      -c max_parallel_workers={{ postgres_max_parallel_workers }}
      -c max_parallel_workers_per_gather={{ postgres_max_parallel_workers_per_gather }}
      -c random_page_cost=1.1
      -c effective_io_concurrency=200
    # random_page_cost/effective_io_concurrency above are the NVMe part: the
    # defaults (4.0 and 1) describe a spinning disk, and leaving them makes
    # the planner avoid index scans it should prefer.
    #
    # Deliberately last in the kernel's OOM shortlist. If a document batch
    # or a runaway query exhausts memory, killing the database is the worst
    # available outcome — everything else here is restartable or
    # rebuildable, and the warehouse is neither.
    oom_score_adj: -500
    volumes:
      # The whole /var/lib/postgresql, which is what the 18+ image declares
      # as its VOLUME; PGDATA is /var/lib/postgresql/18/docker inside it.
      # Mounting .../data instead leaves PGDATA on the container's writable
      # layer and the image refuses to start.
      - postgres-data:/var/lib/postgresql
      # Only runs against an empty data directory — a fresh init, never a
      # re-run against an existing volume. That's also why role creation
      # can't be "just re-apply the playbook" if you rotate this password;
      # see the README's password-rotation note.
      - "{{ state_dir }}/postgres-init:/docker-entrypoint-initdb.d:ro"
    # Docker's default /dev/shm is 64MB. The main buffer pool does not live
    # there, but parallel query workers do, and the failure mode is a query
    # dying with "could not resize shared memory segment" long after the
    # deployment looked fine. Sized against max_parallel_workers.
    shm_size: {{ postgres_shm_size_mb }}m
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sectortrace_app -d sectortrace"]
      interval: 10s
      timeout: 5s
      retries: 5
      # On the very first boot the server is not listening on TCP at all
      # while initdb runs and the init script above executes. Without a
      # start_period the 5 retries expire during that window, the container
      # is marked unhealthy, and every service depending on it refuses to
      # start — which looks exactly like a database that failed.
      start_period: 90s
    ports:
      # Loopback only — nothing outside this box can reach Postgres directly.
      - "127.0.0.1:5432:5432"

  neo4j:
    image: neo4j:5-community
    restart: unless-stopped
    environment:
      NEO4J_AUTH: "neo4j/{{ vault_neo4j_password }}"
      NEO4J_server_memory_heap_initial__size: "{{ neo4j_heap_size }}"
      NEO4J_server_memory_heap_max__size: "{{ neo4j_heap_size }}"
      NEO4J_server_memory_pagecache_size: "{{ neo4j_pagecache_size }}"
    # Heap + pagecache + JVM overhead. A ceiling rather than a reservation:
    # Neo4j is a disposable projection, so if anything here has to die it
    # should be this, and `graph rebuild --clear` puts it back.
    mem_limit: {{ neo4j_mem_limit_mb }}m
    volumes:
      - neo4j-data:/data
      - neo4j-logs:/logs
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/7687'"]
      interval: 10s
      timeout: 5s
      retries: 5
    ports:
      - "127.0.0.1:7474:7474"
      - "127.0.0.1:7687:7687"

  app:
    build:
      context: "{{ repo_root }}"
      dockerfile: Dockerfile
    restart: unless-stopped
    env_file:
      - "{{ state_dir }}/.env"
    depends_on:
      postgres:
        condition: service_healthy
      neo4j:
        condition: service_healthy
    volumes:
      # The WHOLE of /app/data, not just backups. With no ARCHIVE_S3_* group
      # configured the pipeline falls back to a filesystem archive at
      # RAW_ARCHIVE_DIR (data/raw), and mounting only backups left that on
      # the container's writable layer — where a `compose up -d` that
      # recreates the container discards it. That archive is the audit trail
      # behind every figure (settled decision 1) and is rebuildable only by
      # crawling every source again at one request per two seconds, so it is
      # the single most expensive thing here to lose.
      #
      # Mounting the parent also means a future data/ subdirectory is
      # persistent by default rather than by remembering to add it.
      - "{{ state_dir }}/data:/app/data"
      # Structured JSON logs, one file per module. Not evidence, but the
      # operational record of what ran and what it fetched.
      - "{{ state_dir }}/logs:/app/logs"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:1801/health', timeout=3)"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    ports:
      # Loopback only. Reach /admin via an SSH tunnel — see the README —
      # rather than through the public domain, since the app has no
      # authentication of its own (settled decision 8).
      - "127.0.0.1:1801:1801"

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    volumes:
      - "{{ state_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      - app
    ports:
      - "80:80"
      - "443:443"
