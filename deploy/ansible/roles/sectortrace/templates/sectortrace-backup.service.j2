# Generated by Ansible. The verified, application-aware backup
# (pipeline backup: VACUUM/COPY, re-hashed, manifest beside it — see
# docs/BACKUP.md) as a second line under the VPS provider's own daily
# snapshots, not a replacement for them.
[Unit]
Description=SectorTrace verified PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory={{ state_dir }}
ExecStart=/usr/bin/docker compose -f docker-compose.yml exec -T app python -m pipeline backup --keep {{ backup_keep }}
{% if backup_offsite_enabled and vault_archive_s3_bucket %}
# A backup on the same disk as the thing it backs up covers operator error
# and corruption, and nothing at all about losing the disk. This copies the
# verified snapshots off the box afterwards, into a prefix of their own —
# never near the raw archive's keys.
#
# Runs only if the backup above succeeded: systemd stops a oneshot at the
# first failing ExecStart, so a failed snapshot is never followed by an
# upload that would rotate a good remote copy out.
ExecStart=/usr/local/bin/sectortrace-backup-offsite
{% endif %}
