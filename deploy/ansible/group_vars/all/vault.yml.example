---
# Reference copy of every value the vault holds.
#
# You do NOT normally need this file: ./ansible-install.sh asks for these
# interactively on a first run and writes an encrypted vault.yml itself.
# It is here for reference, and for anyone who would rather write the file
# by hand. To do that: copy it to vault.yml, fill it in, then encrypt it in
# place before the first run:
#
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   $EDITOR group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
#
# To edit it again later: ansible-vault edit group_vars/all/vault.yml
#
# If you are writing the passwords yourself, keep them alphanumeric. They
# are interpolated into postgresql://user:PASSWORD@host URLs, and an @ / : #
# or ? splits the URL somewhere it should not — which surfaces as a
# connection error that names anything except the password. Not
# `openssl rand -base64`, whose alphabet includes / and +:
#
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo

vault_contact_email: ""

# --- PostgreSQL --------------------------------------------------------------
# sectortrace_app: owner, DML+DDL — DATABASE_URL. Created as the container's
# POSTGRES_USER on first boot.
# sectortrace_reader: SELECT-only — DATABASE_RO_URL. Created by
# roles/sectortrace/templates/postgres-init-roles.sql.j2, which also grants
# it SELECT by default on every table sectortrace_app creates from then on,
# so a later migration's new table doesn't need a manual GRANT.
vault_postgres_app_password: ""
vault_postgres_reader_password: ""

# --- Neo4j ---------------------------------------------------------------------
vault_neo4j_password: ""

# --- Raw archive: S3-compatible bucket (leave blank for local-disk fallback) -
# Set the whole group together, matching .env.example's own rule — a partial
# set is refused by the application rather than silently falling back.
vault_archive_s3_bucket: ""
vault_archive_s3_endpoint: ""
vault_archive_s3_region: "ams"
vault_archive_s3_url_style: "virtual"
vault_archive_s3_access_key: ""
vault_archive_s3_secret: ""

# --- Optional module API keys (blank is fine; only that module refuses) -----
vault_charity_commission_api_key: ""
vault_companies_house_api_key: ""
vault_cqc_subscription_key: ""
vault_kaggle_username: ""
vault_kaggle_key: ""
