# Generated by Ansible. The monthly one: every object in this box's local
# archive re-hashed against its own content-addressed key.
#
# This is the audit trail behind every figure the portal serves (settled
# decision 1), and it is the only check that would notice a file that was
# written wrong or has rotted since. It is I/O-heavy and it is worth it.
[Unit]
Description=Re-hash the SectorTrace mirror's local raw archive
After=docker.service
Requires=docker.service
OnFailure=sectortrace-mirror-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=infinity
WorkingDirectory={{ state_dir }}
ExecStart=/usr/local/bin/sectortrace-mirror-verify --deep
# Reading every object in the archive would otherwise evict everything the
# database has in the page cache, and the portal would be slow for an hour
# afterwards for no reason anyone could see.
IOSchedulingClass=idle
Nice=10
