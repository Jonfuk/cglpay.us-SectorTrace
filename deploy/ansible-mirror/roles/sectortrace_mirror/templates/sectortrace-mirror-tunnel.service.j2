# Generated by Ansible — tunnel mode only.
#
# The source deployment publishes PostgreSQL on its own loopback, which is
# correct and is why there is a tunnel here rather than a firewall rule
# there. This holds `ssh -N -L` open so the sync container (network_mode:
# host) can reach the source warehouse at 127.0.0.1:{{ mirror_tunnel_local_port }}.
#
# Bound to 127.0.0.1 explicitly, not to *: a forwarded port that listens on
# every interface would put the source's database one hop from anyone who
# can reach this box.
[Unit]
Description=SSH tunnel to the SectorTrace source warehouse ({{ mirror_ssh_host }})
After=network-online.target
Wants=network-online.target

[Service]
# ExitOnForwardFailure turns "the port was already taken" into a failure
# instead of a tunnel that is up and forwards nothing — which presents as a
# connection refused from the sync and sends you looking in the wrong place.
# ServerAliveInterval is what notices a link that has gone away without
# closing; without it the tunnel sits there believing in a dead connection.
ExecStart=/usr/bin/ssh -N \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=accept-new \
    -o BatchMode=yes \
    -i {{ mirror_ssh_key }} \
    -p {{ mirror_ssh_port }} \
    -L 127.0.0.1:{{ mirror_tunnel_local_port }}:{{ mirror_source_pg_host }}:{{ mirror_source_pg_port }} \
    {{ mirror_ssh_user }}@{{ mirror_ssh_host }}
Restart=always
RestartSec=15
# ssh exits 255 for every failure it has, including the ones worth retrying.
SuccessExitStatus=0 255
User=root

[Install]
WantedBy=multi-user.target
