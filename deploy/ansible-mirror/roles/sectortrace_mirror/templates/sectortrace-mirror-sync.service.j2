# Generated by Ansible. One refresh of this mirror from its source
# deployment: warehouse, raw archive, graph projection.
#
# Type=oneshot with no timeout: the first archive sync downloads the source's
# entire archive, and a unit that gives up on it half way through would
# leave a partial local store and no record of how far it got. The script
# takes a lock, so the timer firing again while it runs is harmless.
[Unit]
Description=SectorTrace mirror sync ({{ mirror_sync_mode }} from {{ mirror_source_label | default('the source deployment', true) }})
After=docker.service{% if mirror_sync_mode == 'tunnel' %} sectortrace-mirror-tunnel.service{% endif %}

Requires=docker.service
{% if mirror_sync_mode == 'tunnel' %}
# Wants, not Requires: the script starts the tunnel itself if it is down and
# says so plainly if it cannot. A hard dependency here would turn "the
# source box is rebooting" into a failed unit with no archive sync either,
# and those two steps have nothing to do with each other.
Wants=sectortrace-mirror-tunnel.service
{% endif %}

[Service]
Type=oneshot
TimeoutStartSec=infinity
WorkingDirectory={{ state_dir }}
ExecStart=/usr/local/bin/sectortrace-mirror-sync
