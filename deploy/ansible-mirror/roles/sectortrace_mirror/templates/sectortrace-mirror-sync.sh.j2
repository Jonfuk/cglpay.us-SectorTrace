#!/bin/bash
# Managed by Ansible — see roles/sectortrace_mirror/templates/sectortrace-mirror-sync.sh.j2.
#
# One sync: bring this box's warehouse up to the source deployment's, pull
# whatever the source has added to its raw archive down onto local disk, and
# rebuild the graph projection over the result.
#
# Run by sectortrace-mirror-sync.timer nightly, and by `sectortrace-mirror
# sync` when you want one now. Output goes to stdout, which under systemd is
# the journal: `journalctl -u sectortrace-mirror-sync`.
#
# 0700 and root-owned: it carries the source deployment's bucket
# credentials, the same reasoning as .env's 0600.
set -euo pipefail

STATE_DIR="{{ state_dir }}"
INBOX="$STATE_DIR/data/mirror-inbox"
MIRROR_STATE="$STATE_DIR/mirror-state"
MARKER="$MIRROR_STATE/last-restored"
STATUS="$MIRROR_STATE/last-sync"
LOCK="/var/lock/sectortrace-mirror-sync.lock"

MODE="{{ mirror_sync_mode }}"
SOURCE_LABEL="{{ mirror_source_label | default('(unnamed source)', true) }}"
MIN_FREE_GB={{ mirror_min_free_gb }}
SUPERSEDED_KEEP={{ mirror_superseded_keep }}
STOP_APP={{ 1 if mirror_stop_app_during_sync else 0 }}
ARCHIVE_SYNC={{ 1 if mirror_archive_sync else 0 }}
GRAPH_REBUILD={{ 1 if mirror_graph_rebuild else 0 }}

{% if mirror_sync_mode == 'snapshot' %}
BACKUP_BUCKET="{{ vault_mirror_backup_s3_bucket | default(vault_mirror_archive_s3_bucket, true) }}"
BACKUP_PREFIX="{{ mirror_backup_s3_prefix }}"
BACKUP_ENDPOINT="{{ vault_mirror_backup_s3_endpoint | default(vault_mirror_archive_s3_endpoint, true) }}"
export AWS_ACCESS_KEY_ID="{{ vault_mirror_backup_s3_access_key | default(vault_mirror_archive_s3_access_key, true) }}"
export AWS_SECRET_ACCESS_KEY="{{ vault_mirror_backup_s3_secret | default(vault_mirror_archive_s3_secret, true) }}"
export AWS_DEFAULT_REGION="{{ vault_mirror_backup_s3_region | default(vault_mirror_archive_s3_region, true) }}"
{% else %}
TUNNEL_UNIT="sectortrace-mirror-tunnel.service"
TUNNEL_PORT={{ mirror_tunnel_local_port }}
{% endif %}

FORCE=0
DO_WAREHOUSE=1
DO_ARCHIVE=$ARCHIVE_SYNC

usage() {
    cat <<'USAGE'
sectortrace-mirror-sync — refresh this mirror from its source deployment

  --force           Re-apply the newest snapshot even if it is the one
                    already restored. Snapshot mode only; tunnel mode always
                    copies, because there is no "same file" to recognise.
  --warehouse-only  Skip the raw-archive sync.
  --archive-only    Skip the warehouse step; pull archive objects only.
  -h, --help        This.

With no arguments it does what the timer does: warehouse, then archive, then
the graph projection.
USAGE
}

for arg in "$@"; do
    case "$arg" in
        --force)          FORCE=1 ;;
        --warehouse-only) DO_ARCHIVE=0 ;;
        --archive-only)   DO_WAREHOUSE=0 ;;
        -h|--help)        usage; exit 0 ;;
        *) echo "unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

say() { printf '%s  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die() { say "FAILED: $*"; exit 1; }

# One sync at a time. The first archive sync downloads the source's entire
# archive and can outlive a night, so the timer firing again while it runs is
# expected rather than exceptional — hence a note and a clean exit rather
# than a failure. A sync that is still running tomorrow will say so here
# every night until it finishes, which is the signal to go and look.
exec 9>"$LOCK"
if ! flock -n 9; then
    say "another sync is still running (lock $LOCK) — leaving it alone"
    exit 0
fi

mkdir -p "$INBOX" "$MIRROR_STATE"
chmod 0750 "$MIRROR_STATE"
cd "$STATE_DIR"

compose_sync() {
    docker compose -f docker-compose.sync.yml run --rm sync "$@"
}

# A restore writes a snapshot of what it is replacing *before* it replaces
# it, and an archive sync writes whatever the source has added. Running
# either one out of disk part way through is worse than not starting: check
# first, with a number in the message so it is actionable.
free_gb="$(df -BG --output=avail "$STATE_DIR" | tail -n1 | tr -dc '0-9')"
[ -n "$free_gb" ] || die "could not read free space on $STATE_DIR"
if [ "$free_gb" -lt "$MIN_FREE_GB" ]; then
    die "only ${free_gb}GB free on $STATE_DIR; this sync needs at least ${MIN_FREE_GB}GB (mirror_min_free_gb)"
fi

say "sync starting — source: $SOURCE_LABEL, mode: $MODE, ${free_gb}GB free"

# --- The portal, while the warehouse is replaced --------------------------------
# The warehouse step truncates every table and reloads it inside one
# transaction, which holds an ACCESS EXCLUSIVE lock for its duration.
# Leaving the app up does not avoid an outage — it turns it into requests
# that hang, and lets a long-running portal query hold the restore off
# instead. Stopping it makes the window explicit; Caddy answers it with a
# 503 that says what is happening.
APP_STOPPED=0
start_app() {
    if [ "$APP_STOPPED" -eq 1 ]; then
        say "starting the portal again"
        docker compose start app >/dev/null 2>&1 || say "WARNING: could not start the app container — check \`docker compose ps\`"
        APP_STOPPED=0
        for _ in $(seq 1 60); do
            if curl -fsS -o /dev/null --max-time 3 http://127.0.0.1:1801/health; then
                say "portal healthy again"
                return 0
            fi
            sleep 5
        done
        say "WARNING: the portal did not report healthy within five minutes"
    fi
}
# Runs on every exit path, including a failed restore and a Ctrl-C: a mirror
# that is behind still serves the portal, and leaving it stopped because a
# sync failed turns a stale copy into no copy.
trap start_app EXIT INT TERM

stop_app() {
    if [ "$STOP_APP" -eq 1 ]; then
        say "stopping the portal for the warehouse step"
        docker compose stop app >/dev/null
        APP_STOPPED=1
    fi
}

warehouse_snapshot() {
    [ -n "$BACKUP_BUCKET" ] || die "no backup bucket configured — set vault_mirror_backup_s3_* (or the archive credentials) and re-run the playbook"

    # Automatic snapshots only: `warehouse-<stamp>` and the `-<n>` form the
    # source uses when two land in the same second. A labelled one
    # (warehouse-<stamp>-before-m04-rerun) is a moment somebody deliberately
    # kept on the source, not necessarily the state the source is in now,
    # and a mirror wants the latter. Restore one by hand if you want it.
    say "listing s3://$BACKUP_BUCKET/$BACKUP_PREFIX/"
    local listing newest
    listing="$(aws --endpoint-url "https://$BACKUP_ENDPOINT" s3 ls "s3://$BACKUP_BUCKET/$BACKUP_PREFIX/")" \
        || die "could not list the backup bucket — check the credentials and endpoint"
    newest="$(printf '%s\n' "$listing" | awk '{print $4}' \
        | grep -E '^warehouse-[0-9]{8}T[0-9]{6}Z(-[0-9]+)?\.sql\.gz$' | sort | tail -n1)" || true
    [ -n "$newest" ] || die "no warehouse-*.sql.gz snapshot under s3://$BACKUP_BUCKET/$BACKUP_PREFIX/ — has the source deployment's backup timer run, and is backup_offsite_enabled set there?"

    local restored=""
    [ -f "$MARKER" ] && restored="$(cat "$MARKER")"
    if [ "$newest" = "$restored" ] && [ "$FORCE" -eq 0 ]; then
        say "newest snapshot is $newest, already restored — nothing to do (--force to re-apply)"
        return 0
    fi
    say "newest snapshot is $newest (this box last restored ${restored:-nothing})"

    aws --endpoint-url "https://$BACKUP_ENDPOINT" s3 cp \
        "s3://$BACKUP_BUCKET/$BACKUP_PREFIX/$newest" "$INBOX/$newest" --only-show-errors \
        || die "could not download $newest"
    # The manifest is not needed to restore — the snapshot carries its own
    # checksums and `restore` refuses one that fails them. It is downloaded
    # because it is what says how many rows and which migrations, and an
    # operator asking "what did last night actually bring" should not have
    # to go back to the bucket for it.
    aws --endpoint-url "https://$BACKUP_ENDPOINT" s3 cp \
        "s3://$BACKUP_BUCKET/$BACKUP_PREFIX/${newest%.sql.gz}.manifest.json" \
        "$INBOX/${newest%.sql.gz}.manifest.json" --only-show-errors \
        || say "note: no manifest beside $newest in the bucket"

    stop_app
    say "restoring $newest"
    # --force is unavoidable after the first sync: the target holds the last
    # one. It is not a shortcut — restore still refuses a snapshot that
    # fails its own verification, and still snapshots what it replaces
    # before touching it. Those superseded copies are pruned at the end.
    compose_sync restore "/app/data/mirror-inbox/$newest" --force \
        || die "restore of $newest failed — this box still holds ${restored:-nothing}"
    printf '%s\n' "$newest" > "$MARKER"
    say "restored $newest"

    # Keep only the snapshot now in place. Older downloads are already in
    # the source's bucket, which is where they belong.
    find "$INBOX" -maxdepth 1 -type f -name 'warehouse-*' \
        ! -name "$newest" ! -name "${newest%.sql.gz}.manifest.json" -delete
}

warehouse_tunnel() {
    if ! systemctl is-active --quiet "$TUNNEL_UNIT"; then
        say "$TUNNEL_UNIT is not running — starting it"
        systemctl start "$TUNNEL_UNIT" || die "could not start $TUNNEL_UNIT"
    fi
    # The unit being active is not the same as the far end answering: ssh
    # holds the local port open from the moment it starts, before it has
    # authenticated or forwarded anything.
    local ready=0
    for _ in $(seq 1 30); do
        if timeout 2 bash -c "echo > /dev/tcp/127.0.0.1/$TUNNEL_PORT" 2>/dev/null; then
            ready=1; break
        fi
        sleep 2
    done
    [ "$ready" -eq 1 ] || die "nothing is answering on 127.0.0.1:$TUNNEL_PORT — check \`journalctl -u $TUNNEL_UNIT\`"

    stop_app
    say "copying the source warehouse over the tunnel"
    # --truncate because the target holds the last copy; verification is on
    # by default and is the point of using this path — every value is
    # compared against the source before the copy is called a success.
    compose_sync migrate-postgres --truncate \
        || die "migrate-postgres failed — this box still holds the previous copy"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$MARKER"
    say "warehouse copied and verified against the source"
}

if [ "$DO_WAREHOUSE" -eq 1 ]; then
    if [ "$MODE" = "snapshot" ]; then
        warehouse_snapshot
    else
        warehouse_tunnel
    fi
else
    say "skipping the warehouse step (--archive-only)"
fi

# The portal can serve again from here: what follows fills the archive and
# rebuilds a projection, and neither one blocks a read of the warehouse.
start_app

if [ "$DO_ARCHIVE" -eq 1 ]; then
    # Incremental by construction: it downloads only the objects the local
    # store does not have, and never deletes a local file. The first run is
    # the whole archive, and can take a very long time — it is doing what a
    # crawl would have done, at the speed of a bucket rather than one
    # request every two seconds.
    say "pulling raw-archive objects the local store is missing"
    compose_sync archive-mirror || die "archive-mirror failed"
else
    say "skipping the raw-archive sync"
fi

if [ "$GRAPH_REBUILD" -eq 1 ] && [ "$DO_WAREHOUSE" -eq 1 ]; then
    # After the warehouse moved, not before: the graph is a projection of it,
    # and one projected from the previous copy is wrong in a way nothing
    # would report. --clear because this is a replacement, not a merge.
    say "rebuilding the evidence graph"
    compose_sync graph rebuild --clear || die "graph rebuild failed"
fi

# --- Superseded snapshots ---------------------------------------------------
# `restore --force` sets aside what it replaced, labelled, and a labelled
# backup is never pruned automatically — deliberately, because on a real
# deployment the second-commonest reason to restore is having restored the
# wrong thing.
#
# Here that reasoning is weaker in one specific way and stronger in none:
# what a restore replaces on this box is itself a copy of the source, and
# the source still has the original. Keeping every night's is how a mirror
# fills its disk with copies of a warehouse nobody wrote to.
if [ "$SUPERSEDED_KEEP" -gt 0 ]; then
    mapfile -t stale < <(find "$STATE_DIR/data/backups" -maxdepth 1 -type f \
        -name 'warehouse-*-superseded-by-restore.sql.gz' -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | tail -n +$((SUPERSEDED_KEEP + 1)) | cut -d' ' -f2-)
    for path in ${stale[@]+"${stale[@]}"}; do
        rm -f "$path" "${path%.sql.gz}.manifest.json"
        say "pruned superseded snapshot $(basename "$path")"
    done
fi

{
    printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'source=%s\n' "$SOURCE_LABEL"
    printf 'mode=%s\n' "$MODE"
    printf 'warehouse=%s\n' "$([ -f "$MARKER" ] && cat "$MARKER" || echo none)"
} > "$STATUS"

say "sync complete"
