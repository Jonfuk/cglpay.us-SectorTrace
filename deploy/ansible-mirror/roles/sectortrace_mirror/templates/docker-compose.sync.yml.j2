# Generated by Ansible — see roles/sectortrace_mirror/templates/docker-compose.sync.yml.j2.
#
# The container the nightly sync runs its steps in. Never `up`, only `run`:
# `restore`, `migrate-postgres`, `archive-mirror` and `graph rebuild` are
# each one command that finishes.
#
# Two deliberate differences from every other service on this box.
#
# 1. env_file lists .env and then .env.sync. Compose merges them in order
#    with the later winning, so this is the only container that holds the
#    source deployment's credentials. The portal cannot reach the source's
#    bucket or its warehouse because it was never told they exist.
#
# 2. network_mode: host. The three things a sync has to reach are this box's
#    PostgreSQL, this box's Neo4j, and — in tunnel mode — the SSH tunnel to
#    the source. The first two are published on loopback and the third is a
#    systemd unit on the host, so one namespace reaches all of them. The
#    alternative, a bridge network plus the host's gateway address, means
#    working out that address at run time and re-deriving it whenever the
#    network is recreated. This has no moving parts.
#
#    The cost is that service names do not resolve in here, which is why
#    .env.sync overrides DATABASE_URL and NEO4J_URI to 127.0.0.1.
name: sectortrace-mirror-sync

services:
  sync:
    # Not built here. docker-compose.yml builds this tag; running the same
    # image is what makes "the sync ran the code the portal is running" true
    # by construction rather than by both being rebuilt at the same time.
    image: sectortrace-mirror-app:local
    network_mode: host
    env_file:
      - "{{ state_dir }}/.env"
      - "{{ state_dir }}/.env.sync"
    # The image's CMD serves the web app. Every use of this service is a
    # pipeline subcommand, so the entrypoint is the CLI and the subcommand
    # is the argument: `... run --rm sync archive-mirror`.
    entrypoint: ["python", "-m", "pipeline"]
    volumes:
      # The same whole-of-/app/data view the app has. This is what makes
      # `archive-mirror` write into the portal's own archive and `restore`
      # able to read a snapshot the host downloaded.
      - "{{ state_dir }}/data:/app/data"
      - "{{ state_dir }}/logs:/app/logs"
