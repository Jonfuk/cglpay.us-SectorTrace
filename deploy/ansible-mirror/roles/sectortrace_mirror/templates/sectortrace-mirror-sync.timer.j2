# Generated by Ansible.
[Unit]
Description=Refresh the SectorTrace mirror from its source deployment

[Timer]
OnCalendar=*-*-* {{ mirror_sync_time }}:00
# Spreads the start, so a bucket serving more than one mirror is not asked
# for the same object by all of them at the same second.
RandomizedDelaySec={{ mirror_sync_randomized_delay }}
# A box that was off at 04:30 syncs when it comes back rather than waiting
# another day: a mirror's whole value is how far behind it is.
Persistent=true

[Install]
WantedBy=timers.target
