# Generated by Ansible. Instantiated by OnFailure= on the mirror's units, with
# the failing unit's name as the instance: sectortrace-mirror-alert@<unit>.
#
# A template rather than one unit per caller, so the sync and both verify
# units share it and a third would need no new file.
[Unit]
Description=Report a failed SectorTrace mirror unit (%i)

[Service]
Type=oneshot
# Not Requires=docker.service: this must still run, and still report, when
# the reason the unit failed is that docker is down.
ExecStart=/usr/local/bin/sectortrace-mirror-alert %i
