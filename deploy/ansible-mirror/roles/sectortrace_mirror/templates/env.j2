# Generated by Ansible from group_vars/all/{vars,vault}.yml — do not edit by
# hand, it will be overwritten on the next playbook run. Edit vault.yml (or
# vars.yml for non-secret values) and re-run ansible-mirror.sh instead.
#
# This is what the ALWAYS-ON containers see: postgres, neo4j, app, caddy.
# It deliberately holds no credential belonging to the source deployment —
# those are in .env.sync, which only the sync container reads. The portal
# serving this warehouse has no way to reach the source's buckets or its
# database, which is the point.

CONTACT_EMAIL={{ contact_email }}
ADMIN_UI_ENABLED={{ admin_ui_enabled | lower }}

# --- Database: this box's PostgreSQL, the two roles created in postgres-init/
DATABASE_URL=postgresql://sectortrace_app:{{ vault_postgres_app_password }}@postgres:5432/sectortrace
DATABASE_RO_URL=postgresql://sectortrace_reader:{{ vault_postgres_reader_password }}@postgres:5432/sectortrace

# DATABASE_SOURCE_URL is deliberately absent here. It is the variable the
# mirror commands read, and it belongs to the sync container alone — set in
# .env.sync, in live PostgreSQL modes only.

# --- Derived Evidence Graph: Neo4j -------------------------------------------
{% if mirror_graph_rebuild %}
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD={{ vault_neo4j_password }}
NEO4J_DATABASE=neo4j
{% else %}
# mirror_graph_rebuild is false, so nothing on this box projects the
# warehouse into Neo4j and the graph would only ever be stale or empty.
NEO4J_ENABLED=false
{% endif %}

# --- Raw archive: local disk, by design --------------------------------------
# No ARCHIVE_S3_* group, so the archive backend is the filesystem. /app/data
# is bind-mounted from {{ state_dir }}/data, which makes this
# {{ state_dir }}/data/raw on the host.
#
# That is the whole shape of this deployment: the source keeps its archive in
# S3, the mirror keeps a copy of it on its own disk, and `pipeline
# archive-mirror` (in the sync container, which does have the bucket
# credentials) is the only thing that crosses between the two.
#
# It grows monotonically — nothing is ever pruned, by design — and it grows
# to whatever the source's archive is. Watch the disk.
RAW_ARCHIVE_DIR=data/raw

# --- This box is a mirror -----------------------------------------------------
# Read by `pipeline mirror`, and an assertion about the box rather than a
# convenience: every command that reads it behaves differently for having it
# set — `mirror pull` replaces the warehouse without asking twice — so a
# collecting deployment must never carry it.
#
# Set for the always-on containers too, not only the sync: it is what lets
# `sectortrace-mirror sync-status` answer from the app container, with no
# credential of the source's anywhere near it.
MIRROR_ENABLED=true
MIRROR_SOURCE_LABEL={{ mirror_source_label }}
MIRROR_STATE_DIR=data/mirror-state
MIRROR_INBOX_DIR=data/mirror-inbox
MIRROR_MAX_SNAPSHOT_AGE_HOURS={{ mirror_max_snapshot_age_hours }}

# --- Structured document analysis --------------------------------------------
# As on a source deployment: the always-on app image has no parser or OCR
# toolchain in it, and these only take effect in the documents-worker image
# run on demand via docker-compose.documents.yml.
#
# On a mirror there is a second thing to know: derived output written here is
# destroyed by the next warehouse sync along with everything else. Process
# documents on the source deployment, where the result is kept.
DOCUMENT_ANALYSIS_ENABLED=true
DOCUMENT_PARSER=pymupdf
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_WORKER_CONCURRENCY={{ document_worker_concurrency }}
DERIVED_ARCHIVE_DIR=data/derived

{% if assistant_runtime_enabled %}
# --- Local analyst assistant (BETA-107): model endpoints --------------------
# Both point at the one Ollama in docker-compose.assistant.yml. The
# synthesis adapter sends model "{{ assistant_lfm_model_tag }}"; the router
# sends "{{ assistant_needle_model_tag }}" — on this box the same weights
# under a second tag (`ollama cp`, done by the playbook). A key in
# .env.merge below still overrides either of these.
ASSISTANT_OLLAMA_URL=http://ollama:11434/v1
ASSISTANT_NEEDLE_URL=http://ollama:11434/v1
{% endif %}
{% if assistant_app_enabled %}
# Turned ON for this box. Only valid once `pipeline nlp assistant-eval`
# reported gate.may_enable: true (docs/assistant.md). On a beta box the
# usual way to set this is .env.merge, not here.
ASSISTANT_ENABLED=true
{% endif %}

# --- Module API keys ----------------------------------------------------------
# env.j2 sets none. On a dr_mirror nothing collects — every row here arrived
# from the source deployment's warehouse — and a key that cannot be used is a
# key that should not be on the box.
#
# A `beta` box (mirror_role: beta) is the exception: a writable checkout you
# test a branch against, where a queue item may need one real collection
# module. Its keys go in {{ mirror_env_merge_file }} on the box — gitignored,
# 0600, outside the checkout the beta pre-task resets every run — and are
# merged in below. Anything set there overrides the same key above, because
# it comes later. See deploy/ansible-mirror/.env.merge.example.
{% if mirror_env_merge_text | default('') | length > 0 %}

# === Merged from .env.merge ({{ mirror_env_merge_file }}) =====================
# Operator-managed. NOT generated from a tracked file — edit .env.merge on the
# box and re-run the playbook. Everything below this line is that file, verbatim.
{{ mirror_env_merge_text }}
{% endif %}
