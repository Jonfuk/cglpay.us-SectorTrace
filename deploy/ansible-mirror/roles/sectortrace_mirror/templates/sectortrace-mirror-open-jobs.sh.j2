#!/bin/bash
# Generated by Ansible — the bounded, operator-only Open Jobs shadow run.
# The host lock keeps a timer retry from overlapping a manually started run;
# the module's database keys provide the replay backstop inside the container.
set -euo pipefail

STATE_DIR="{{ state_dir }}"
LOCK="/var/lock/sectortrace-mirror-open-jobs.lock"
exec 9>"$LOCK"
if ! flock -n 9; then
    echo "Open Jobs run already active; leaving this invocation alone."
    exit 0
fi

cd "$STATE_DIR"
exec docker compose -f docker-compose.yml run --rm --no-deps app \
    /app/.venv/bin/python -m pipeline run m35_open_jobs \
    --limit {{ open_jobs_max_releases_per_run }} --origin scheduled
