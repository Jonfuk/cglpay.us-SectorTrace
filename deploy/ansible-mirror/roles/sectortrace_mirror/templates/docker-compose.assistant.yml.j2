# Generated by Ansible — see roles/sectortrace_mirror/templates/docker-compose.assistant.yml.j2.
#
# The local analyst assistant's model runtime (BETA-107). One Ollama
# serving both roles the assistant calls — synthesis and the router. The
# playbook `ollama pull`s assistant_lfm_ollama_ref, and env.j2 sets
# ASSISTANT_LFM_MODEL / ASSISTANT_NEEDLE_MODEL to that same string, so the
# name the app sends is the name Ollama has. ASSISTANT_OLLAMA_URL and
# ASSISTANT_NEEDLE_URL in .env both point here.
#
# Brought up with the always-on stack, but only when
# assistant_runtime_enabled is true. Rendered either way so the file is
# present the day someone flips the switch.
#
# The weights volume is deliberately outside the warehouse: a sync replaces
# postgres and the archive, and would otherwise take an hour of model
# downloads with it. On a beta box this container just keeps running across
# a reseed.
name: sectortrace-mirror-assistant

networks:
  default:
    # The mirror's always-on network, joined by name — same pattern as the
    # documents worker. Not sectortrace_net (see docker-compose.mirror.yml.j2
    # for why a mirror uses its own).
    name: sectortrace_mirror_net
    external: true

volumes:
  # Model weights (the 350M default GGUF is ~220 MB; the 2.6B option ~1.6 GB)
  # plus Ollama's manifests. A named volume, not state_dir/data: not
  # warehouse content, must outlive a sync, safe to delete (the playbook
  # re-pulls).
  ollama-models:

services:
  ollama:
    image: {{ assistant_ollama_image }}
    restart: unless-stopped
    environment:
      # Listen on the compose network. No `ports:` block, so nothing off-box
      # can reach it; the app container resolves `ollama` by service name.
      OLLAMA_HOST: "0.0.0.0:11434"
      # Ollama's default is 2048, which truncates the grounding step's
      # retrieved passages long before the model's own limit. The assistant
      # is designed around 32K-context synthesis (pipeline/assistant/
      # adapters.py); LFM2.5-1.2B handles ~125K.
      OLLAMA_CONTEXT_LENGTH: "32768"
      # Keep the model resident an hour after the last call. The assistant is
      # interactive and bursty, `nlp assistant-eval` fires ~160 calls in
      # sequence, and on a CPU box the cold reload is the slow part — this
      # container exists only to serve this model, so hold it.
      OLLAMA_KEEP_ALIVE: "60m"
    # A ceiling, not a reservation — a runaway hits this and is killed alone
    # rather than the kernel's OOM killer choosing PostgreSQL. See
    # assistant_ollama_mem_limit_mb in vars.yml for why it is not in the
    # preflight budget.
    mem_limit: {{ assistant_ollama_mem_limit_mb }}m
    volumes:
      - ollama-models:/root/.ollama
    healthcheck:
      # `ollama list` talks to the local daemon and fails until it is
      # serving — a readiness signal, not just "process alive".
      test: ["CMD-SHELL", "ollama list >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
