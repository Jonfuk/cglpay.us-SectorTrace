# Generated by Ansible. Built here but never brought up with `docker compose
# up` — on-demand batch work, run explicitly, per docs/document-analysis.md.
#
# On a mirror, know what you are doing before you use it: derived output is
# written into the warehouse, and the warehouse is replaced wholesale by the
# next sync. Processing documents here is a way to spend an afternoon of CPU
# on a result that is discarded at 04:30. Do it on the source deployment,
# where it is kept, and let it arrive here in the next sync.
#
# It is built anyway because a mirror is also the box you take a source
# deployment's place with, and an image that has never been built is a bad
# thing to discover on that day.
name: sectortrace-mirror-documents

networks:
  default:
    name: sectortrace_mirror_net
    external: true

services:
  documents:
    build:
      context: "{{ repo_root }}"
      dockerfile: deploy/Dockerfile.documents
      args:
        # The [assistant] extra (`openai`) when this box runs the assistant —
        # against OpenRouter (assistant_app_enabled) or a self-hosted Ollama
        # (assistant_runtime_enabled). `sectortrace-mirror nlp assistant` and
        # `nlp assistant-eval` run in this worker. Railway builds neither
        # this file nor this arg.
        INSTALL_ASSISTANT: "{{ (assistant_runtime_enabled or assistant_app_enabled) | lower }}"
    env_file:
      - "{{ state_dir }}/.env"
    environment:
      # Every use of this service is `run --rm`, so a container-layer model
      # cache is downloaded and then thrown away on every invocation. The
      # `nlp` embedder's first-use download (all-MiniLM-L6-v2, ~90MB, plus
      # whatever a GLiNER model pulls) has to land somewhere that outlives
      # the container — point Hugging Face / sentence-transformers at the
      # bind-mounted cache below. Unset for the OCR batch, which needs none
      # of this.
      HF_HOME: /app/nlp-cache/huggingface
      SENTENCE_TRANSFORMERS_HOME: /app/nlp-cache/sentence-transformers
    # The blast-radius limit: parsing and OCR are the spiky part of this
    # deployment. Hitting a cgroup limit kills this container alone and
    # records a retryable failure; without it the kernel's OOM killer
    # chooses host-wide and may well pick PostgreSQL.
    mem_limit: {{ documents_mem_limit_mb }}m
    cpus: {{ [(ansible_processor_vcpus | int * 0.75) | round(1), 1.0] | max }}
    volumes:
      - "{{ state_dir }}/data:/app/data"
      # Model weights for the `nlp` layer, kept out of data/ on purpose: it is
      # not warehouse content, it must survive a warehouse sync, and it is
      # safe to delete (next run re-downloads). See the state directory tree
      # in the role's tasks.
      - "{{ state_dir }}/nlp-cache:/app/nlp-cache"
