#!/bin/bash
# Generated by Ansible — restart the beta analysis worker when its heartbeat
# is stale. Docker restarts crashes; this handles a live but wedged process.
set -euo pipefail

STATE_DIR="{{ state_dir }}"
cd "$STATE_DIR"
COMPOSE=(docker compose -f docker-compose.documents.yml)

if ! "${COMPOSE[@]}" ps --status running --services | grep -Fxq analysis-worker; then
    logger -t sectortrace-analysis-watchdog "analysis-worker is not running; starting it"
    "${COMPOSE[@]}" up -d analysis-worker
    exit 0
fi

if ! "${COMPOSE[@]}" exec -T analysis-worker python -m pipeline analysis health \
        --max-age-seconds 120 >/dev/null; then
    logger -t sectortrace-analysis-watchdog "analysis-worker heartbeat is stale; restarting it"
    "${COMPOSE[@]}" restart analysis-worker
fi
