# Generated by Ansible — see roles/sectortrace_mirror/templates/env.sync.j2.
#
# Read ONLY by the sync container (docker-compose.sync.yml), on top of .env.
# Docker Compose merges env_file entries in order and the later one wins, so
# what is here overrides what .env said for that one container.
#
# Everything the mirror knows about the source deployment is in this file,
# and nothing else on the box reads it. The portal container cannot reach
# the source's bucket or its warehouse because it has never been told they
# exist.
#
# 0600, root-owned, like .env — it carries credentials.

# --- Loopback, not service names ----------------------------------------------
# The sync container runs with network_mode: host, so `postgres` and `neo4j`
# do not resolve in it. They do not need to: this box publishes both on its
# own loopback (see docker-compose.yml), and so does the SSH tunnel in
# tunnel mode. One network namespace reaches all three, which is exactly why
# host networking is used here rather than a bridge and a guessed gateway
# address.
DATABASE_URL=postgresql://sectortrace_app:{{ vault_postgres_app_password }}@127.0.0.1:5432/sectortrace
DATABASE_RO_URL=postgresql://sectortrace_reader:{{ vault_postgres_reader_password }}@127.0.0.1:5432/sectortrace
{% if mirror_graph_rebuild %}
NEO4J_URI=bolt://127.0.0.1:7687
{% endif %}

{% if mirror_sync_mode == 'tunnel' %}
# --- The source warehouse, through the SSH tunnel -----------------------------
# DATABASE_SOURCE_URL never selects the backend — DATABASE_URL above stays
# the database everything writes to. It is read by `migrate-postgres` and
# `check-postgres-sync` and nothing else, which is why it is safe for it to
# name a warehouse this box must never write to.
#
# The far end is {{ mirror_source_pg_host }}:{{ mirror_source_pg_port }} on
# {{ mirror_ssh_host }}, held open by sectortrace-mirror-tunnel.service.
DATABASE_SOURCE_URL=postgresql://{{ mirror_source_pg_user }}:{{ vault_mirror_source_pg_password }}@127.0.0.1:{{ mirror_tunnel_local_port }}/{{ mirror_source_pg_database }}
{% endif %}

{% if mirror_sync_mode == 'snapshot' %}
# --- The source's snapshot bucket ---------------------------------------------
# Where the source's sectortrace-backup-offsite script puts its verified
# `pipeline backup` snapshots. `pipeline mirror pull` lists this prefix,
# takes the newest automatic snapshot and restores it.
#
# Kept separate from the ARCHIVE_S3_* group below even when it is the same
# bucket under a different prefix: on this box those two are read for
# different reasons, and collapsing them would be one credential where there
# should be the option of two.
MIRROR_BACKUP_S3_BUCKET={{ vault_mirror_backup_s3_bucket | default(vault_mirror_archive_s3_bucket, true) }}
MIRROR_BACKUP_S3_ENDPOINT={{ vault_mirror_backup_s3_endpoint | default(vault_mirror_archive_s3_endpoint, true) }}
MIRROR_BACKUP_S3_REGION={{ vault_mirror_backup_s3_region | default(vault_mirror_archive_s3_region, true) }}
MIRROR_BACKUP_S3_URL_STYLE={{ vault_mirror_backup_s3_url_style | default(vault_mirror_archive_s3_url_style, true) }}
MIRROR_BACKUP_S3_ACCESS_KEY={{ vault_mirror_backup_s3_access_key | default(vault_mirror_archive_s3_access_key, true) }}
MIRROR_BACKUP_S3_SECRET={{ vault_mirror_backup_s3_secret | default(vault_mirror_archive_s3_secret, true) }}
MIRROR_BACKUP_S3_PREFIX={{ mirror_backup_s3_prefix }}
{% endif %}

{% if mirror_archive_sync and vault_mirror_archive_s3_bucket %}
# --- The source's raw archive bucket ------------------------------------------
# Setting this group makes the sync container's archive backend S3 — which
# is what `pipeline archive-mirror` needs, because it reads the bucket and
# writes into the local FilesystemArchive at RAW_ARCHIVE_DIR. The direction
# is bucket -> disk, and it never deletes a local file.
#
# The always-on app has no such group, so it keeps reading the local disk.
# The difference between the two containers is this file.
ARCHIVE_S3_BUCKET={{ vault_mirror_archive_s3_bucket }}
ARCHIVE_S3_ENDPOINT={{ vault_mirror_archive_s3_endpoint }}
ARCHIVE_S3_REGION={{ vault_mirror_archive_s3_region }}
ARCHIVE_S3_URL_STYLE={{ vault_mirror_archive_s3_url_style }}
ARCHIVE_S3_ACCESS_KEY={{ vault_mirror_archive_s3_access_key }}
ARCHIVE_S3_SECRET={{ vault_mirror_archive_s3_secret }}
{% endif %}
