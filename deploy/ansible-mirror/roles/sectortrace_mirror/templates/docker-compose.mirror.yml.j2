# Generated by Ansible — see roles/sectortrace_mirror/templates/docker-compose.mirror.yml.j2.
# The mirror's always-on stack: postgres, neo4j, app, Caddy in front of it.
#
# It is the self-host build's compose file with three differences, all of
# them consequences of this box being a copy:
#
#  * the app is given a fixed image tag, because two other compose files
#    here (the documents worker's sibling, and the sync) run the same image
#    rather than building their own copy of it;
#  * nothing collects, so no schedule and no API keys;
#  * the archive is on local disk (RAW_ARCHIVE_DIR), filled from the
#    source's bucket by the sync — see .env.
name: sectortrace-mirror

networks:
  default:
    # Not sectortrace_net: a box that has been both a deployment and a
    # mirror would otherwise have two projects fighting over one network
    # name, and the documents compose file attaches to it by name.
    name: sectortrace_mirror_net
    # An explicit subnet, which the self-host build does not need and this
    # does. `migrate-postgres` refuses to run when the source and the target
    # report the same server identity — (current_database, current_schema,
    # inet_server_addr, inet_server_port) — because copying a warehouse onto
    # itself is not a thing anyone means to do.
    #
    # Left to Docker, both boxes take the same address from the same default
    # pool: docker0 gets 172.17, the first user-defined bridge gets 172.18,
    # and PostgreSQL is the first container up on each. Two independently
    # provisioned hosts then both answer 172.18.0.2:5432 with a database
    # called sectortrace in schema public — identical on all four counts,
    # and a refusal that reads like a configuration error nobody made.
    #
    # Overridable in zz-local.yml: if it collides with something already on
    # this box, compose says so at `up` ("Pool overlaps with other one").
    ipam:
      config:
        - subnet: "{{ mirror_docker_subnet }}"

# Named volumes for the two databases rather than bind mounts into
# state_dir, for the reasons the self-host build learned on a real box:
#
#  * PostgreSQL 18+ images store data in a major-version subdirectory and
#    declare the volume at /var/lib/postgresql, not .../data. A bind mount
#    one level too deep is reported as an "unused mount/volume" and the
#    container refuses to start if anything is in it.
#  * Both entrypoints drop from root to their own service user, and neither
#    chowns the *parent* of its data directory. A root-owned bind mount is
#    then untraversable by the very user that needs it. Docker seeds a fresh
#    named volume from the image, ownership included, so the question never
#    arises.
#
# `docker volume inspect sectortrace-mirror_postgres-data` says where one
# physically lives. `docker compose down` keeps them; only `down -v`
# destroys them — and on this box that is recoverable by re-syncing, which
# is the one genuine advantage a mirror has.
volumes:
  postgres-data:
  neo4j-data:
  neo4j-logs:
  caddy-data:
  caddy-config:

services:
  postgres:
    # Stock postgres:18 plus pgvector and postgis — see deploy/postgres/Dockerfile.
    # The mirror runs the same migration tree as the primary, so it needs the
    # same extensions or a migration that references one would fail here while
    # succeeding there.
    build:
      context: "{{ repo_root }}/deploy/postgres"
    image: sectortrace-postgres:18
    restart: unless-stopped
    environment:
      POSTGRES_USER: sectortrace_app
      POSTGRES_PASSWORD: "{{ vault_postgres_app_password }}"
      # Deliberately the maintenance database, NOT sectortrace. The warehouse
      # needs the collation selected by postgres-init/01-roles.sql: builtin
      # C.UTF-8 for snapshot/tunnel modes, or libc en_US.utf8 for URL mode so
      # the local warehouse sorts like the managed PostgreSQL source. Letting
      # the image create it here would use the cluster default instead.
      #
      # On a mirror there is a second reason it has to be right: every sync
      # verifies this warehouse against the source's, value by value. Two
      # warehouses that sort differently disagree about their own contents.
      POSTGRES_DB: postgres
    command: >
      postgres
      -c shared_buffers={{ postgres_shared_buffers }}
      -c effective_cache_size={{ postgres_effective_cache_size }}
      -c max_connections={{ postgres_max_connections }}
      -c work_mem={{ postgres_work_mem }}
      -c maintenance_work_mem={{ postgres_maintenance_work_mem }}
      -c max_worker_processes={{ postgres_max_worker_processes }}
      -c max_parallel_workers={{ postgres_max_parallel_workers }}
      -c max_parallel_workers_per_gather={{ postgres_max_parallel_workers_per_gather }}
      -c random_page_cost=1.1
      -c effective_io_concurrency=200
    # Last in the kernel's OOM shortlist, as on a source deployment. The
    # warehouse here is rebuildable from the source, but rebuilding it means
    # another full restore and, on a bad night, another full archive sync —
    # cheap is not the same as free.
    oom_score_adj: -500
    volumes:
      - postgres-data:/var/lib/postgresql
      # Only runs against an empty data directory — a fresh init, never a
      # re-run against an existing volume.
      - "{{ state_dir }}/postgres-init:/docker-entrypoint-initdb.d:ro"
    shm_size: {{ postgres_shm_size_mb }}m
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sectortrace_app -d sectortrace"]
      interval: 10s
      timeout: 5s
      retries: 5
      # The first boot runs initdb and the role bootstrap before the server
      # listens on TCP at all; without a start_period the retries expire in
      # that window and everything depending on it refuses to start.
      start_period: 90s
    ports:
{% if postgres_external_allowed_ips | length > 0 %}
      # Published on every IPv4 interface: postgres_external_allowed_ips is
      # set, so this box takes direct PostgreSQL connections. What limits
      # that to the listed addresses is NOT here and NOT ufw — a published
      # Docker port bypasses ufw entirely (deploy/ansible/README.md, "What
      # ufw doesn't cover"). It is the DOCKER-USER iptables rules that
      # sectortrace-mirror-pg-firewall installs. The explicit 0.0.0.0 keeps
      # this to IPv4, matching the v4-only allowlist. The sync container
      # still reaches PostgreSQL at 127.0.0.1:5432 as before.
      - "0.0.0.0:5432:5432"
{% else %}
      # Loopback only — and, on this box, also how the sync container
      # reaches it: that one runs with network_mode: host and connects to
      # 127.0.0.1:5432 rather than to the service name.
      - "127.0.0.1:5432:5432"
{% endif %}

{% if mirror_graph_rebuild %}
  neo4j:
    image: neo4j:5-community
    restart: unless-stopped
    environment:
      NEO4J_AUTH: "neo4j/{{ vault_neo4j_password }}"
      NEO4J_server_memory_heap_initial__size: "{{ neo4j_heap_size }}"
      NEO4J_server_memory_heap_max__size: "{{ neo4j_heap_size }}"
      NEO4J_server_memory_pagecache_size: "{{ neo4j_pagecache_size }}"
    # A ceiling rather than a reservation. Neo4j is the most disposable
    # thing on the most disposable box here: `graph rebuild --clear` puts it
    # back, and the sync runs exactly that every night anyway.
    mem_limit: {{ neo4j_mem_limit_mb }}m
    volumes:
      - neo4j-data:/data
      - neo4j-logs:/logs
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/7687'"]
      interval: 10s
      timeout: 5s
      retries: 5
    ports:
      - "127.0.0.1:7474:7474"
      - "127.0.0.1:7687:7687"
{% endif %}

  app:
    build:
      context: "{{ repo_root }}"
      dockerfile: Dockerfile
      args:
        # `openai` (the [assistant] extra) only when this box provisions the
        # assistant runtime. Railway builds the same Dockerfile with no
        # args, so its image never gets it — see Dockerfile.
        INSTALL_ASSISTANT: "{{ assistant_runtime_enabled | lower }}"
    # Named explicitly so docker-compose.sync.yml and the documents worker
    # can run this exact image instead of building a second copy of it from
    # the same context. Built here, used there.
    image: sectortrace-mirror-app:local
    restart: unless-stopped
    env_file:
      - "{{ state_dir }}/.env"
    depends_on:
      postgres:
        condition: service_healthy
{% if mirror_graph_rebuild %}
      neo4j:
        condition: service_healthy
{% endif %}
    volumes:
      # The whole of /app/data. On this box that is mostly data/raw — the
      # local copy of the source's archive, which is what the portal's
      # provenance links resolve against — plus the snapshots the sync
      # downloads and the ones `restore` sets aside.
      - "{{ state_dir }}/data:/app/data"
      - "{{ state_dir }}/logs:/app/logs"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:1801/health', timeout=3)"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    ports:
      # Loopback only. Reach /admin over an SSH tunnel — the app has no
      # authentication of its own (settled decision 8), and that is as true
      # of a mirror as of the deployment it copies.
      - "127.0.0.1:1801:1801"

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    volumes:
      - "{{ state_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      - app
    ports:
      - "80:80"
      - "443:443"
