-- Generated by Ansible. Runs once, automatically, only when the Postgres
-- container initialises an *empty* /var/lib/postgresql — see
-- docker-compose.yml's postgres-init bind mount. The image creates the
-- sectortrace_app superuser from POSTGRES_USER/POSTGRES_PASSWORD before this
-- runs; everything else is here.
--
-- A mirror that created its warehouse differently from the deployment it
-- copies would fail the comparison every sync, and the collation below is
-- the reason why. URL mode follows the managed PostgreSQL source's
-- libc/en_US.utf8 collation; snapshot and tunnel modes keep the bytewise
-- builtin collation used by the SQLite-compatible warehouse.

{% if mirror_sync_mode == 'url' %}
-- Railway's managed PostgreSQL source uses libc/en_US.utf8. Matching that
-- provider and locale keeps MIN/MAX and primary-key ordering identical
-- during PostgreSQL-to-PostgreSQL verification.
{% else %}
-- `builtin` + C.UTF-8 gives bytewise ordering, so `ORDER BY name` matches
-- SQLite's BINARY ordering. The builtin provider is version-stable in a way
-- a libc locale is not.
{% endif %}
--
-- On this box it decides something more immediate as well. Every sync either
-- restores a snapshot taken from the source or copies the source's rows
-- directly, and then verifies the result against it. Two warehouses that
-- sort differently disagree about their own contents, and the sync would
-- report a mirror that is in fact correct as failed — or, worse, the other
-- way round.
--
-- TEMPLATE = template0 is required to use a locale that differs from the
-- cluster's. See pipeline/migrations/postgres/README.md.
{% if mirror_sync_mode == 'url' %}
CREATE DATABASE sectortrace
    LOCALE_PROVIDER = libc
    LC_COLLATE = 'en_US.utf8'
    LC_CTYPE = 'en_US.utf8'
    TEMPLATE = template0;
{% else %}
CREATE DATABASE sectortrace
    LOCALE_PROVIDER = builtin
    BUILTIN_LOCALE = 'C.UTF-8'
    TEMPLATE = template0;
{% endif %}

-- The read-only role DATABASE_RO_URL points at. See
-- pipeline/migrations/postgres/README.md for why the split exists: a role
-- without INSERT refuses at the server, whatever a bug in the application
-- code does.
CREATE ROLE sectortrace_reader LOGIN PASSWORD '{{ vault_postgres_reader_password }}';
GRANT CONNECT ON DATABASE sectortrace TO sectortrace_reader;

-- The remaining grants are per-database objects, so they have to be applied
-- inside the warehouse rather than from the maintenance database.
\connect sectortrace

GRANT USAGE ON SCHEMA public TO sectortrace_reader;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO sectortrace_reader;

-- No tables exist yet — `pipeline migrate` creates them after this script
-- runs, as sectortrace_app. This is what makes sectortrace_reader keep up
-- with every future migration without a manual GRANT, including the tables a
-- restore drops rows into.
ALTER DEFAULT PRIVILEGES FOR ROLE sectortrace_app IN SCHEMA public
    GRANT SELECT ON TABLES TO sectortrace_reader;
