#!/usr/bin/env bash
# Generated by Ansible — roles/sectortrace_mirror/templates/sectortrace-mirror-pg-firewall.sh.j2
#
# The allowlist for direct PostgreSQL access (postgres_external_allowed_ips).
# It lives in iptables rather than ufw because a published Docker port does
# not traverse ufw's chains at all — see deploy/ansible/README.md, "What ufw
# doesn't cover". Docker consults DOCKER-USER for every packet it routes into
# a container and never flushes it, but the kernel's tables are not
# persistent on Debian and Docker recreates DOCKER-USER empty on daemon
# start, so this script is run both from the playbook and at boot by
# sectortrace-mirror-pg-firewall.service.
#
# All rules go in one dedicated chain, SECTORTRACE_PG, jumped to from the top
# of DOCKER-USER. That makes every re-apply a flush-and-refill of one chain
# we own — fully idempotent, and nothing else's rules are ever touched.
set -euo pipefail

CHAIN=SECTORTRACE_PG
PORT=5432
IFACE="{{ postgres_public_interface }}"

# The chain may or may not exist yet; -N fails if it does.
iptables -N "$CHAIN" 2>/dev/null || true

{% if postgres_external_allowed_ips | length > 0 %}
if [ -z "$IFACE" ]; then
  echo "sectortrace-mirror-pg-firewall: postgres_public_interface is empty;" \
       "cannot scope the default-drop. Refusing to touch iptables." >&2
  exit 1
fi

iptables -F "$CHAIN"

# Return to DOCKER-USER (i.e. let Docker's normal processing continue) for
# connections from a listed address.
{% for ip in postgres_external_allowed_ips %}
iptables -A "$CHAIN" -i "$IFACE" -p tcp --dport "$PORT" -s {{ ip }} -j RETURN
{% endfor %}

# Every other NEW connection arriving on the public interface for 5432 is
# dropped. ESTABLISHED/RELATED packets never match --ctstate NEW, and on-box
# / container traffic arrives on lo or a docker interface, not "$IFACE", so
# neither is affected.
iptables -A "$CHAIN" -i "$IFACE" -p tcp --dport "$PORT" \
  -m conntrack --ctstate NEW -j DROP

# Jump into our chain from the very top of DOCKER-USER, exactly once.
if ! iptables -C DOCKER-USER -j "$CHAIN" 2>/dev/null; then
  iptables -I DOCKER-USER 1 -j "$CHAIN"
fi

echo "sectortrace-mirror-pg-firewall: 5432 open to {{ postgres_external_allowed_ips | join(', ') }} on $IFACE; all other off-box sources dropped."
{% else %}
# Allowlist empty: remove the jump and the chain, leaving iptables as it was
# before this feature was ever switched on. The compose file has 5432 bound
# to loopback in this case, so there is nothing to police.
iptables -D DOCKER-USER -j "$CHAIN" 2>/dev/null || true
iptables -F "$CHAIN" 2>/dev/null || true
iptables -X "$CHAIN" 2>/dev/null || true

echo "sectortrace-mirror-pg-firewall: allowlist empty; SECTORTRACE_PG chain removed, 5432 is loopback-only."
{% endif %}
