# Generated by Ansible. The weekly comparison: the source's bucket key set
# against this box's disk, and — in tunnel mode — both warehouses value by
# value. Transfers nothing.
[Unit]
Description=Verify the SectorTrace mirror against its source
After=docker.service
Requires=docker.service
OnFailure=sectortrace-mirror-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=infinity
WorkingDirectory={{ state_dir }}
ExecStart=/usr/local/bin/sectortrace-mirror-verify
