# Generated by Ansible — roles/sectortrace_mirror/templates/sectortrace-mirror-pg-firewall.service.j2
#
# Re-applies the DOCKER-USER allowlist for direct PostgreSQL access. The
# kernel's iptables state is not persistent on Debian by default, and Docker
# recreates DOCKER-USER on daemon start, so without this a reboot (or a
# `systemctl restart docker`) would leave the rules gone. That fails closed —
# PostgreSQL unreachable from off-box until the next playbook run — but this
# puts them back as soon as Docker is up, which is what an operator expects.
[Unit]
Description=SectorTrace mirror: DOCKER-USER allowlist for direct PostgreSQL
After=docker.service
Requires=docker.service
# Re-run when Docker restarts, since that is the other thing that can drop
# the rules.
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/sectortrace-mirror-pg-firewall

[Install]
WantedBy=multi-user.target
