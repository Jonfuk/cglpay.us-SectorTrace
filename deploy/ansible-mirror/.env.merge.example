# .env.merge — operator-managed extra environment for THIS box.
#
# Copy to  <state_dir>/.env.merge  on the box and re-run ./ansible-mirror.sh.
# state_dir for a mirror is /opt/sectortrace-mirror/state, so the file is
#
#     /opt/sectortrace-mirror/state/.env.merge
#
# On every playbook run env.j2 appends this file, verbatim, to the end of the
# rendered .env. That means:
#
#   * KEY=VALUE lines, one per line, no `export` — the same rules as .env.
#     dotenv cannot parse an unquoted multi-line value, so put a JSON blob
#     (GOOGLE_SERVICE_ACCOUNT_JSON) on a single line.
#   * A key set here overrides the same key from env.j2, because it comes
#     last — both for Docker Compose's env_file and for pipeline/config.py.
#   * It is NOT tracked by git (see the repo .gitignore) and NOT rendered
#     from a template, so it is the one file on the box that survives both
#     `git reset --hard` (the beta pre-task) and a .env re-render.
#   * Keep it 0600 and root-owned — it holds credentials, exactly like .env.
#
# This exists for a `beta` box (mirror_role: beta) that has to exercise real
# collection. A dr_mirror collects nothing and needs none of this — leaving
# the file absent is the correct state there.

# --- Module API keys the pipeline asks for (pipeline/config.py) --------------
# Uncomment and fill in only the ones the modules you run here actually need.
# CHARITY_COMMISSION_API_KEY=
# COMPANIES_HOUSE_API_KEY=
# CQC_SUBSCRIPTION_KEY=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# BRIGHTDATA_API_KEY=
# ZENROWS_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Analyst assistant (BETA-107; OpenRouter since BETA-114) --------------
# Inference runs on OpenRouter. Set assistant_app_enabled: true and the
# router/answerer slugs in group_vars; the key can go here instead of the
# vault. Then, once `pipeline nlp assistant-eval` reports gate.may_enable:
# true (docs/assistant.md), turn the feature on here so it survives the beta
# checkout reset without setting assistant_app_enabled in a tracked file:
# ASSISTANT_API_KEY=sk-or-...
# ASSISTANT_ENABLED=true
# The first model is tried first; OpenRouter tries each fallback after a
# rate-limit, provider outage, or other model error. Keep these comma-separated.
# ASSISTANT_NEEDLE_MODEL=openai/gpt-oss-20b
# ASSISTANT_NEEDLE_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct,mistralai/mistral-small-24b-instruct-2501
# ASSISTANT_LFM_MODEL=openai/gpt-oss-20b
# ASSISTANT_LFM_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct,mistralai/mistral-small-24b-instruct-2501
# Optional high-volume routing controls. `latency` prioritises fast providers;
# leave blank to use OpenRouter's normal price/uptime balancing. Provider slugs
# in ORDER/IGNORE are comma-separated.
# ASSISTANT_PROVIDER_SORT=latency
# ASSISTANT_PROVIDER_ORDER=
# ASSISTANT_PROVIDER_IGNORE=
# ASSISTANT_MAX_CONCURRENCY=8
# ASSISTANT_MAX_RETRIES=2
# ASSISTANT_RETRY_BASE_SECONDS=0.5
# ASSISTANT_RETRY_MAX_SECONDS=8
# ASSISTANT_CIRCUIT_BREAKER_FAILURES=3
# ASSISTANT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# ASSISTANT_REQUEST_TIMEOUT_SECONDS=60
# If claim-signal models are overridden separately, these replace the
# assistant-role fallbacks for new analysis releases.
# CLAIM_SIGNAL_SCOUT_FALLBACK_MODELS=
# CLAIM_SIGNAL_EXTRACTOR_FALLBACK_MODELS=
# CLAIM_SIGNAL_REFLECTION_FALLBACK_MODELS=

# --- Anything else you want to override on this box only --------------------
# DOCUMENT_OCR_ENABLED=false
