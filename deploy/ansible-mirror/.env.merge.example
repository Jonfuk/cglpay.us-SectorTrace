# .env.merge — operator-managed extra environment for THIS box.
#
# Copy to  <state_dir>/.env.merge  on the box and re-run ./ansible-mirror.sh.
# state_dir for a mirror is /opt/sectortrace-mirror/state, so the file is
#
#     /opt/sectortrace-mirror/state/.env.merge
#
# On every playbook run env.j2 appends this file, verbatim, to the end of the
# rendered .env. That means:
#
#   * KEY=VALUE lines, one per line, no `export` — the same rules as .env.
#     dotenv cannot parse an unquoted multi-line value, so put a JSON blob
#     (GOOGLE_SERVICE_ACCOUNT_JSON) on a single line.
#   * A key set here overrides the same key from env.j2, because it comes
#     last — both for Docker Compose's env_file and for pipeline/config.py.
#   * It is NOT tracked by git (see the repo .gitignore) and NOT rendered
#     from a template, so it is the one file on the box that survives both
#     `git reset --hard` (the beta pre-task) and a .env re-render.
#   * Keep it 0600 and root-owned — it holds credentials, exactly like .env.
#
# This exists for a `beta` box (mirror_role: beta) that has to exercise real
# collection. A dr_mirror collects nothing and needs none of this — leaving
# the file absent is the correct state there.

# --- Module API keys the pipeline asks for (pipeline/config.py) --------------
# Uncomment and fill in only the ones the modules you run here actually need.
# CHARITY_COMMISSION_API_KEY=
# COMPANIES_HOUSE_API_KEY=
# CQC_SUBSCRIPTION_KEY=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# BRIGHTDATA_API_KEY=
# ZENROWS_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Local analyst assistant (BETA-107) ------------------------------------
# Set assistant_runtime_enabled: true in group_vars first — that stands up
# Ollama and points ASSISTANT_OLLAMA_URL / ASSISTANT_NEEDLE_URL at it. Then,
# once `pipeline nlp assistant-eval` reports gate.may_enable: true
# (docs/assistant.md), turn the feature on here so it survives the beta
# checkout reset without setting assistant_app_enabled in a tracked file:
# ASSISTANT_ENABLED=true

# --- Anything else you want to override on this box only --------------------
# DOCUMENT_OCR_ENABLED=false
