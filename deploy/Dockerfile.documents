# Local document-analysis worker for Unraid/Docker hosts.  This is deliberately
# separate from the Railway image, which serves persisted results and does not
# need heavyweight parser or OCR system dependencies.
# Bookworm's Ghostscript is 10.0.0, a release that OCRmyPDF rejects for
# --skip-text/--redo-ocr due to PDF-corruption regressions.  Trixie supplies
# Ghostscript 10.05.x while retaining the same Python 3.12 worker runtime.
FROM ghcr.io/astral-sh/uv:python3.12-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ghostscript \
        tesseract-ocr \
        tesseract-ocr-eng \
        antiword \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the lockfile-resolved application environment before source so normal
# code changes retain Docker's dependency-layer cache. Docling is deliberately
# omitted: the Unraid batch uses PyMuPDF plus standard-library DOCX/PPTX parsers,
# and Docling pulls PyTorch plus CUDA libraries for no benefit here.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    --extra postgres --extra storage --extra graph

COPY pipeline ./pipeline
RUN uv sync --frozen --no-dev --extra postgres --extra storage --extra graph

# These are the two document packages the PyMuPDF/OCRmyPDF batch actually
# invokes. Keep them separate from the rich `documents` extra above so this
# practical Unraid worker stays small and CPU-only.
RUN uv pip install --python /app/.venv/bin/python --no-cache \
    "PyMuPDF>=1.24,<2" "ocrmypdf>=16,<17"

ENV PATH="/app/.venv/bin:$PATH" \
    UV_CACHE_DIR="/tmp/uv-cache" \
    UV_NO_SYNC=1 \
    LOGS_DIR="/tmp/sectortrace-logs" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN mkdir -p "$UV_CACHE_DIR" && chown 99:100 "$UV_CACHE_DIR"

# `docker run … documents status` is therefore equivalent to
# `uv run pipeline documents status` in a checkout.
ENTRYPOINT ["pipeline"]
CMD ["--help"]
