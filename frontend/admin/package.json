{
  "name": "@sectortrace/admin",
  "private": true,
  "type": "module",
  "description": "SectorTrace admin operations-control-room application. Static generation + client-side data loading; no Node/Nitro runtime in production. Served under /admin/.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/spa-fallback.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "nuxt": "^4.5.2",
    "vue": "3.6.0-rc.6",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@nuxt/eslint": "^1.9.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vue-tsc": "^2.1.0"
  },
  "overrides": {
    "vue": "3.6.0-rc.6",
    "@vue/compiler-sfc": "3.6.0-rc.6"
  }
}
