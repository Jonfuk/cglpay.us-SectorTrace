{
  "name": "@sectortrace/public",
  "private": true,
  "type": "module",
  "description": "SectorTrace public evidence-atlas application. Static generation + client-side data loading; no Node/Nitro runtime in production.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/spa-fallback.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "maplibre-gl": "^5.24.0",
    "nuxt": "^4.5.2",
    "vue": "3.6.0-rc.6",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.0"
  },
  "overrides": {
    "vue": "3.6.0-rc.6",
    "@vue/compiler-sfc": "3.6.0-rc.6"
  }
}
