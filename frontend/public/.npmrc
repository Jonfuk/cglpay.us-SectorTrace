# Nuxt 4's peer-dependency graph combined with the pinned Vue 3.6 RC (which
# carries Vapor) trips a known npm arborist peer-set resolver bug on strict
# installs. legacy-peer-deps routes around it deterministically so `npm ci`
# reproduces the committed lockfile in CI and the Docker build stage. Revisit
# and remove once Vue 3.6 is stable and Nuxt's peer ranges include it.
legacy-peer-deps=true
# Reproducible, frozen builds only.
save-exact=false
fund=false
audit=false
